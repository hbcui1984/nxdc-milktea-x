// 券包模拟数据
export type CouponDetail = {
	title: string
	desc: string
	image: string
	expire: string
	coupon_amount: string
	id: string
}

export type PackageCoupon = {
	id: number
	coupon_id: string
	coupon_num: number
	packages_id: number
	detail: CouponDetail
}

export type PackageItem = {
	id: number
	has_send_num: number
	start_at: string
	end_at: string
	deleted_at: string | null
	buy_status: number
	coupons: PackageCoupon[]
	amount: string
	intro: string
	name: string
	title: string
	image: string
	status: number
	type: number
	original_amount: string
}

