// 订单模拟数据
export type OrderStoreInfo = {
	address: string
	longitude: string
	latitude: string
	mobile: string
	name: string
}

export type OrderGoodsItem = {
	number: number
	originAmount: string
	price: string
	unit: string
	property: string
	image: string
	amount: string
	name: string
}

export type OrderItem = {
	coupon_name: string
	receive_at: number
	pay_mode: string
	pay_user_name: string
	updated_at: number
	goods_num: number
	completed_at: number
	created_at: number
	invoice_status: number
	sended_time: number
	status_text: string
	remark: string
	coupon_amount: number
	mobile: string
	user_name: string
	payed_at: number
	total_amount: string
	store: OrderStoreInfo
	send_status: number
	discount: string[]
	status: number
	completed_time: string
	amount: string
	multi_store: string
	productioned_time: string
	postscript: string
	sort_num: string
	order_no: string
	id: number
	typeCate: number
	goods: OrderGoodsItem[]
}

