export type ThemeItem = {
	activityId: number
	activityName: string
	activityCode: string
	cardShelvesCategoryId: number
	imageUrls: string
}

export type CategoryItem = {
	id: number
	themesList: ThemeItem[]
	name: string
	activityIds: string
}

export type GiftCardsData = {
	banner_activity_id: number
	img: string
	content: string
	category_list: CategoryItem[]
}

