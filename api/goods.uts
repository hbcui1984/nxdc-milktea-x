// 商品模拟数据
// 类型定义
type PropertyValue = {
	id: number
	value: string
	is_default: number
}

type Property = {
	name: string
	desc: string | null
	values: PropertyValue[]
}

type GoodItem = {
	id: number
	name: string
	content: string
	price: number
	images: string
	use_property: boolean
	property: Property[]
}

export type Category = {
	id: number
	name: string
	icon: string
	goods_list: GoodItem[]
}

