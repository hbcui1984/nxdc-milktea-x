// 地址列表模拟数据
export type DistrictInfo = {
	districts: string
	area: string
	city: string
	province: string
}

export type AddressData = {
	id: number
	accept_name: string
	mobile: string
	province_name: string
	area: number
	city: number
	sex: number
	district: DistrictInfo
	street: string
	inner: boolean
	lat: string
	door_number: string
	is_default: number
	province: number
	area_name: string
	city_name: string
	poiname: string
}

