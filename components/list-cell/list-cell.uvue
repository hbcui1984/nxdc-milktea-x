<template>
	<view
		class="tui-cell-class tui-list-cell"
		:class="{ 'tui-cell-arrow': arrow, 'tui-cell-last': last, 'tui-radius': radius }"
		:hover-class="hover ? 'tui-cell-hover' : ''"
		:style="{background: bgcolor, fontSize: size + 'rpx', color: color, padding: padding}"
		:hover-stay-time="150"
		@tap="handleClick"
	>
		<slot></slot>
		<image src="/static/images/navigator-1.png" class="arrow" v-if="arrow"></image>
	</view>
	<view v-if="!last" class="tui-cell-line" :style="{marginLeft: lineLeft ? '30rpx' : '0rpx', marginRight: lineRight ? '30rpx' : '0rpx'}"></view>
</template>

<script setup lang="uts">
	const props = defineProps({
		arrow: {
			type: Boolean,
			default: false
		},
		hover: {
			type: Boolean,
			default: true
		},
		lineLeft: {
			type: Boolean,
			default: false
		},
		lineRight: {
			type: Boolean,
			default: false
		},
		padding: {
			type: String,
			default: "26rpx 30rpx"
		},
		last: {
			type: Boolean,
			default: false
		},
		radius: {
			type: Boolean,
			default: false
		},
		bgcolor: {
			type: String,
			default: "#fff"
		},
		size: {
			type: Number,
			default: 28
		},
		color: {
			type: String,
			default: "#5A5B5C"
		},
		index: {
			type: Number,
			default: 0
		}
	})

	const emit = defineEmits<{
		(e: 'click', data: UTSJSONObject): void
	}>()

	const handleClick = () => {
		emit('click', { index: props.index })
	}
</script>

<style lang="scss">
	.tui-list-cell {
		position: relative;
		width: 100%;
		box-sizing: border-box;
		overflow: hidden;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.tui-radius {
		border-radius: 12rpx;
		overflow: hidden;
	}

	.tui-cell-hover {
		background-color: #f7f7f9;
	}

	.tui-cell-line {
		height: 2rpx;
		background-color: #eeeeee;
	}

	.arrow {
		width: 50rpx;
		height: 50rpx;
		position: relative;
		margin-right: -10rpx;
		flex-shrink: 0;
	}
</style>
