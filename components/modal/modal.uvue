	}

	.danger-outline {
		color: #ed3f14;
		background-color: transparent;
		border-width: 1px;
		border-style: solid;
		border-color: #ed3f14;
	}

	.red {
		background-color: #e41f19;
		color: #ffffff;
	}

	.red-hover {
		background-color: #c51a15;
		color: #e5e5e5;
	}

	.red-outline {
		color: #e41f19;
		background-color: transparent;
		border-width: 1px;
		border-style: solid;
		border-color: #e41f19;
	}

	.warning {
		background-color: #ff7900;
