		border-width: 1px;
		border-style: solid;
		border-color: #333333;
	}

	.gray {
		background-color: #ededed;
		color: #999999;
	}

	.gray-hover {
		background-color: #d5d5d5;
		color: #898989;
	}

	.gray-outline {
		color: #999999;
		background-color: transparent;
		border-width: 1px;
		border-style: solid;
		border-color: #999999;
	}

	.outline-hover {
		opacity: 0.6;
	}

	.circle-btn {
		border-radius: 40rpx;
	}
</style>
