<template>
	<view class="modal-wrapper" @touchmove.stop.prevent>
		<view v-if="show" class="modal-box modal-show" :style="{width: width, padding: padding, borderRadius: radius}">
			<view v-if="custom">
				<slot></slot>
			</view>
			<view v-else>
				<view class="modal-title" v-if="title != ''">{{title}}</view>
				<view class="modal-content" :class="[title != '' ? '' : 'mtop']" :style="{color: color, fontSize: size + 'rpx'}">
					<slot></slot>
				</view>
				<view class="modalBtn-box" :class="[button.length != 2 ? 'flex-column' : '']">
					<view v-for="(item, index) in button" :key="index" class="btn-wrapper" :class="[button.length != 2 ? 'btn-full-width' : '']">
						<button class="modal-btn" 
								:class="[
									getButtonTypeClass(item),
									button.length != 2 ? 'btn-width' : '',
									button.length > 2 ? 'mbtm' : '',
									shape == 'circle' ? 'circle-btn' : '',
									getButtonSizeClass(item)
								]"
								:hover-class="getButtonHoverClass(item)"
								@tap="handleClick(index)">{{getButtonText(item)}}</button>
					</view>
				</view>
			</view>
		</view>
		<view v-if="show" class="modal-mask mask-show" @tap="handleClickCancel"></view>
	</view>
</template>

<script setup lang="uts">
	type ModalButton = {
		text ?: string
		type ?: string
		plain ?: boolean
		size ?: string
	}

	const props = defineProps({
		show: {
			type: Boolean,
			default: false
		},
		custom: {
			type: Boolean,
			default: false
		},
		width: {
			type: String,
			default: "84%"
		},
		padding: {
			type: String,
			default: "40rpx"
		},
		radius: {
			type: String,
			default: "24rpx"
		},
		title: {
			type: String,
			default: ""
		},
		content: {
			type: String,
			default: ""
		},
		color: {
			type: String,
			default: "#999"
		},
		size: {
			type: Number,
			default: 28
		},
		shape: {
			type: String,
			default: 'square'
		},
		button: {
			type: Array as PropType<ModalButton[]>,
			default: (): ModalButton[] => [{
				text: "取消",
				type: "red",
				plain: true
			}, {
				text: "确定",
				type: "red",
				plain: false
			}]
		},
		maskClosable: {
			type: Boolean,
			default: true
		},
		fadein: {
			type: Boolean,
			default: false
		}
	})

	const emit = defineEmits<{
		(e: 'click', data: UTSJSONObject): void
		(e: 'cancel'): void
	}>()

	const getButtonText = (item: ModalButton): string => {
		return item.text ?? "确定"
	}

	const getButtonTypeClass = (item: ModalButton): string => {
		const btnType = item.type ?? 'primary'
		const isPlain = item.plain ?? false
		if (isPlain) {
			return btnType + '-outline'
		}
		return btnType
	}

	const getButtonHoverClass = (item: ModalButton): string => {
		const btnType = item.type ?? 'primary'
		const isPlain = item.plain ?? false
		if (isPlain) {
			return 'outline-hover'
		}
		return btnType + '-hover'
	}

	const getButtonSizeClass = (item: ModalButton): string => {
		const btnSize = item.size ?? 'default'
		return 'btn-' + btnSize
	}

	const handleClick = (index: number) => {
		if (!props.show) return
		emit('click', { index: index })
	}

	const handleClickCancel = () => {
		if (!props.maskClosable) return
		emit('cancel')
	}
</script>

<style lang="scss">
	.modal-wrapper {
		position: fixed;
		top: 0;
		left: 0;
		width: 0;
		height: 0;
		overflow: visible;
		z-index: 9999995;
		pointer-events: none;
	}

	.modal-box {
		position: fixed;
		left: 50%;
		top: 50%;
		margin-left: -42%;
		margin-top: -150rpx;
		background-color: #fff;
		z-index: 9999998;
		opacity: 0;
		box-sizing: border-box;
		pointer-events: auto;
	}

	.modal-show {
		opacity: 1;
	}

	.modal-mask {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.6);
		z-index: 9999996;
		opacity: 0;
		pointer-events: auto;
	}

	.mask-show {
		opacity: 1;
	}

	.modal-title {
		text-align: center;
		font-size: 34rpx;
		color: #333333;
		padding-top: 20rpx;
		font-weight: bold;
	}

	.modal-content {
		color: #999999;
		font-size: 28rpx;
		padding-top: 20rpx;
		padding-bottom: 60rpx;
	}

	.mtop {
		margin-top: 30rpx;
	}

	.mbtm {
		margin-bottom: 30rpx;
	}

	.modalBtn-box {
		width: 100%;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.flex-column {
		flex-direction: column;
	}

	.btn-wrapper {
		width: 46%;
	}

	.btn-full-width {
		width: 80%;
	}

	.modal-btn {
		width: 100%;
		height: 68rpx;
		line-height: 68rpx;
		position: relative;
		border-radius: 60rpx;
		font-size: 28rpx;
		overflow: visible;
		margin-left: 0;
		margin-right: 0;
	}

	.btn-default {
		font-size: 28rpx;
	}

	.btn-lg {
		font-size: 32rpx;
	}

	.btn-sm {
		font-size: 24rpx;
	}

	.btn-width {
		width: 80%;
	}

	.primary {
		background-color: #97AF13;
		color: #ffffff;
	}

	.primary-hover {
		background-color: #97AF13;
		color: #e5e5e5;
	}

	.primary-outline {
		color: #97AF13;
		background-color: transparent;
		border-width: 1px;
		border-style: solid;
		border-color: #97AF13;
	}

	.danger {
		background-color: #ed3f14;
		color: #ffffff;
	}

	.danger-hover {
		background-color: #d53912;
