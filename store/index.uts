/**
 * 全局状态管理 - uni-app x 版本
 * 使用 reactive 替代 Vuex
 */
import { MemberData } from '@/api/member.uts'
import { AddressData, DistrictInfo, mockAddresses } from '@/api/addresses.uts'

// 会员信息类型（复用 api 数据层定义，避免重复维护）
export type MemberType = MemberData

// 地区信息类型（复用 api 数据层定义）
export type DistrictType = DistrictInfo

// 地址类型（复用 api 数据层定义）
export type AddressType = AddressData

// 门店类型
export type StoreType = {
	id: number
	name: string
	address: string
	distance: string
	openTime: string
	closeTime: string
	min_price: number
	packing_fee: number
}

// 购物车商品类型
export type CartItemType = {
	id: number
	name: string
	price: number
	quantity: number
	specs: string
	image: string
}

// 订单类型
export type OrderType = {
	id: string
	orderNo: string
	status: number
	totalPrice: number
	items: CartItemType[]
	createTime: string
}

// 全局状态类型
export type State = {
	store: StoreType | null
	cart: CartItemType[]
	orderType: string
	address: AddressType | null
	addresses: AddressType[]
	member: MemberType | null
	order: OrderType | null
}

// 创建响应式状态
const initialState: State = {
	store: null,
	cart: [],
	orderType: 'takein',
	address: null,
	addresses: mockAddresses.slice(),
	member: null,
	order: null
}

export const state = reactive(initialState)

// Getters
export const isLogin = computed((): boolean => {
	return state.member != null
})

// Mutations
export const setOrderType = (type: string) => {
	state.orderType = type
}

export const setMember = (member: MemberType | null) => {
	state.member = member
}

export const setAddress = (address: AddressType | null) => {
	state.address = address
}

export const setAddresses = (addresses: AddressType[]) => {
	state.addresses = addresses
}

export const setStore = (store: StoreType | null) => {
	state.store = store
}

export const setCart = (cart: CartItemType[]) => {
	state.cart = cart
}

export const removeCart = () => {
	state.cart = []
}

export const setOrder = (order: OrderType | null) => {
	state.order = order
}

// 默认导出
export default {
	state,
	isLogin,
	setOrderType,
	setMember,
	setAddress,
	setAddresses,
	setStore,
	setCart,
	removeCart,
	setOrder
}
