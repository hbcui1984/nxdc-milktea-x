<template>
	<view class="container">
		<view class="invoice-box-1">
			<list-cell :hover="false">
				<view class="d-flex">
					<view class="label">发票类型</view>
					<view class="flex-fill d-flex flex-column">
						<view class="text-base">电子普通发票</view>
						<view class="sub-text">电子发票与纸质普通发票具备同等法律效益，可支持报销入账</view>
					</view>
				</view>
			</list-cell>
			<view class="line"></view>
			<list-cell :hover="false">
				<view class="d-flex">
					<view class="label">发票内容</view>
					<view class="flex-fill text-base">食品</view>
				</view>
			</list-cell>
			<view class="line"></view>
			<list-cell :hover="false" last>
				<view class="d-flex">
					<view class="label">发票抬头</view>
					<view class="flex-fill">
						<view class="radio-group">
							<view class="radio mr-20" :class="{'checked': form.taitou == 0}" @click="setTaitou(0)">个人</view>
							<view class="radio" :class="{'checked': form.taitou == 1}" @click="setTaitou(1)">公司</view>
						</view>
					</view>
				</view>
			</list-cell>
		</view>
		
		<view class="invoice-box-2">
			<list-cell :hover="false">
				<view class="d-flex w-100">
					<view class="label">姓名</view>
					<view class="flex-fill d-flex align-items-center">
						<input class="flex-fill mr-20 input-field" type="text" :value="form.username" @input="onUsernameInput" placeholder="请输入姓名" placeholder-class="placeholder-style"/>
						<view class="text-color-danger">必填</view>
					</view>
				</view>
			</list-cell>
			<view class="line"></view>
			<list-cell :hover="false">
				<view class="d-flex w-100">
					<view class="label">邮箱地址</view>
					<view class="flex-fill d-flex align-items-center">
						<input class="flex-fill mr-20 input-field" type="text" :value="form.email" @input="onEmailInput" placeholder="请输入邮箱地址" placeholder-class="placeholder-style"/>
						<view class="text-color-danger">必填</view>
					</view>
				</view>
			</list-cell>
			<view class="line"></view>
			<list-cell :hover="false" last>
				<view class="d-flex w-100">
					<view class="label">手机号</view>
					<view class="flex-fill d-flex align-items-center">
						<input class="flex-fill mr-20 input-field" type="text" :value="form.telphone" @input="onTelphoneInput" placeholder="请输入手机号码" placeholder-class="placeholder-style"/>
						<view class="text-color-danger">必填</view>
					</view>
				</view>
			</list-cell>
		</view>
		
		<view class="btn-box">
			<view class="item">
				<button type="primary" plain class="btn">导入发票抬头</button>
			</view>
			<view class="item">
				<button type="primary" class="btn">提交</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import listCell from '../../components/list-cell/list-cell.uvue'

type InvoiceFormType = {
	taitou: number
	username: string
	email: string
	telphone: string
}

const form = reactive({
	taitou: 0,
	username: '',
	email: '',
	telphone: ''
} as InvoiceFormType)

const setTaitou = (value: number) => {
	form.taitou = value
}

const onUsernameInput = (e: InputEvent) => {
	form.username = e.detail.value
}

const onEmailInput = (e: InputEvent) => {
	form.email = e.detail.value
}

const onTelphoneInput = (e: InputEvent) => {
	form.telphone = e.detail.value
}
</script>

