		url: '/pages/integrals/integrals'
	})
}

const attendance = () => {
	if (!isLogin.value) {
		login()
		return
	}
	uni.navigateTo({
		url: '/pages/attendance/attendance'
	})
}

const orders = () => {
	if (!isLogin.value) {
		login()
		return
	}
	uni.navigateTo({
		url: '/pages/orders/orders'
	})
}

const memberCode = () => {
	if (!isLogin.value) {
		login()
		return
	}
	uni.navigateTo({
		url: '/pages/mine/member-code'
	})
}

const coupons = () => {
	if (!isLogin.value) {
		login()
		return
	}
	uni.navigateTo({
		url: '/pages/coupons/coupons'
	})
}

const userinfo = () => {
	if (!isLogin.value) {
		login()
		return
	}
	uni.navigateTo({
		url: '/pages/mine/userinfo'
	})
}

const services = () => {
	uni.navigateTo({
		url: '/pages/services/services'
	})
}

const giftCards = () => {
	if (!isLogin.value) {
		login()
		return
	}
	uni.navigateTo({
		url: '/pages/giftcard/giftcard'
	})
}
</script>

