<script setup lang="uts">
import { state, isLogin } from '@/store/index.uts'
import { MemberData as MemberType } from '@/api/member.uts'

const newIcon = ref<string>('https://img-shop.qmimg.cn/s16/images/2020/05/12/ffb0613dded704b6.png')

const member = computed((): MemberType | null => {
	return state.member
})

const growthValue = computed((): number => {
	if (!isLogin.value || member.value == null) return 0
	const currentValue = member.value!.currentValue ?? 0
	const needValue = member.value!.needValue ?? 0
	if (currentValue + needValue == 0) return 0
	return currentValue / (currentValue + needValue) * 100
})

const login = () => {
	uni.navigateTo({
		url: '/pages/login/login'
	})
}

const packages = () => {
	if (!isLogin.value) {
		login()
		return
	}
	uni.navigateTo({
		url: '/pages/packages/index'
	})
}

const balance = () => {
	if (!isLogin.value) {
		login()
		return
	}
	uni.navigateTo({
		url: '/pages/balance/balance'
	})
}

