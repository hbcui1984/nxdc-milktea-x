<script setup lang="uts">
import { state } from '@/store/index.uts'

const memberAvatar = computed((): string => {
	return state.member?.avatar ?? '/static/images/mine/default.png'
})

const memberNickname = computed((): string => {
	return state.member?.nickname ?? ''
})

const memberLevel = computed((): number => {
	return state.member?.memberLevel ?? 0
})

const couponNum = computed((): number => {
	return state.member?.couponNum ?? 0
})

const pointNum = computed((): number => {
	return state.member?.pointNum ?? 0
})

const balanceNum = computed((): number => {
	return state.member?.balance ?? 0
})

const giftBalance = computed((): number => {
	return state.member?.giftBalance ?? 0
})

const integrals = () => {
	uni.navigateTo({
		url: '/pages/integrals/integrals'
	})
}

const balance = () => {
	uni.navigateTo({
		url: '/pages/balance/balance'
	})
}

const coupons = () => {
	uni.navigateTo({
		url: '/pages/coupons/coupons'
	})
}
</script>

