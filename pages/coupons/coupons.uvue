	display: flex;
	flex-direction: column;
	height: 100%;
}

.exchange-box {
	flex-shrink: 0;
	height: 200rpx;
	background-color: #ffffff;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.exchange-box .input-box {
	display: flex;
	align-items: stretch;
	width: 70%;
	flex-shrink: 0;
}

.exchange-box .input-box input {
	flex: 1;
	height: 80rpx;
	border-width: 1rpx;
	border-style: solid;
	border-color: #eeeeee;
	border-right-width: 0;
	border-top-left-radius: 8rpx;
	border-bottom-left-radius: 8rpx;
	padding: 20rpx;
	font-size: 28rpx;
	color: #5A5B5C;
}

.exchange-box .input-box button {
	border-top-left-radius: 0;
	border-bottom-left-radius: 0;
	border-top-right-radius: 8rpx;
	border-bottom-right-radius: 8rpx;
	display: flex;
	align-items: center;
}

.tabbar {
	flex-shrink: 0;
	width: 100%;
	height: 120rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.tabbar .tab {
	flex: 1;
	height: 100%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	font-size: 28rpx;
	color: #5A5B5C;
	position: relative;
}

.tabbar .tab .title {
	padding: 15rpx 0;
}

.tabbar .tab.active {
	color: #ADB838;
}

.tabbar .tab.active .title {
	border-bottom-width: 5rpx;
	border-bottom-style: solid;
	border-bottom-color: #ADB838;
}

.bottom-box {
	height: 80rpx;
	flex-shrink: 0;
	background-color: #ffffff;
}

.bottom-box .item {
	padding: 0 20rpx;
	position: relative;
}

.coupon-list {
	height: 100%;
}

.wrapper {
	padding: 0 40rpx;
	display: flex;
	flex-direction: column;
}

.wrapper .coupon {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	margin-bottom: 30rpx;
	padding: 0 30rpx;
	border-radius: 6rpx;
	box-shadow: 0 10rpx 10rpx -10rpx rgba(15, 15, 15, 0.1);
	position: relative;
}

.wrapper .coupon .detail {
	padding: 20rpx 0;
	position: relative;
	border-bottom-width: 1rpx;
	border-bottom-style: dashed;
	border-bottom-color: #c6c6c6;
}

.wrapper .coupon .detail .coupon-img {
	width: 150rpx;
	height: 150rpx;
	margin-right: 40rpx;
}

.wrapper .coupon .detail-link {
	height: 80rpx;
}

.modal-content {
	padding: 20rpx;
}

.use-coupon-btn {
	width: 95%;
	border-radius: 100px;
}

.w-100 {
	width: 100%;
}

.h-100 {
	height: 100%;
}

.mb-10 {
	margin-bottom: 10rpx;
}

.mb-20 {
	margin-bottom: 20rpx;
}

.mb-30 {
	margin-bottom: 30rpx;
}

.flex-fill {
	flex: 1;
}

.overflow-hidden {
	overflow: hidden;
}

.text-truncate {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.pre-line {
	white-space: pre-line;
