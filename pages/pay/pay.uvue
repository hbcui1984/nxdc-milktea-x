								<image src="/static/images/navigator-1.png" class="arrow"></image>
							</view>
							<view class="address-info">
								<view class="address-name">{{ address.accept_name }}</view>
								<view class="address-sex">{{ address.sex == 0 ? '先生' : '女士' }}</view>
								<view class="address-mobile">{{ address.mobile }}</view>
							</view>
						</view>
					</list-cell>
				</template>
				<template v-if="orderType == 'takein'">
					<list-cell arrow class="meal-time">
						<view class="meal-time-row">
							<view class="meal-time-title">取餐时间</view>
							<view class="meal-time-value">立即用餐</view>
						</view>
					</list-cell>
					<list-cell class="contact" last :hover="false">
						<view class="contact-row">
							<view class="contact-title">联系电话</view>
							<view class="contact-input-wrapper">
								<input class="contact-input" placeholder="请输入手机号码" value="18666600000"/>
							</view>
							<view class="contact-tip">自动填写</view>
						</view>
					</list-cell>
				</template>
				<template v-else>
					<list-cell>
						<view class="delivery-section">
							<view class="delivery-row">
								<view class="delivery-label">预计送达时间</view>
								<view class="delivery-time">15:18</view>
								<image src="/static/images/navigator-1.png" class="arrow"></image>
							</view>
							<view class="delivery-tip">
								特殊时期减少接触，请修改下方订单备注
							</view>
						</view>
					</list-cell>
				</template>
			</view>
			<!-- 购物车列表 begin -->
			<view class="section-2">
				<view class="cart">
					<list-cell last v-for="(item, index) in cart" :key="index">
						<view class="cart-item">
							<view class="cart-item-header">
								<view class="cart-item-name-wrapper">
									<view class="cart-item-name">
										{{ item.name }}
									</view>
								</view>
								<view class="cart-item-price-wrapper">
									<view class="cart-item-number">x{{ item.number }}</view>
									<view class="cart-item-price">￥{{ item.price }}</view>
								</view>
							</view>
							<view class="cart-item-props">
								{{ item.props_text }}
							</view>
						</view>
					</list-cell>
					<template v-if="orderType == 'takeout'">
						<list-cell last v-if="storeInfo.packing_fee > 0">
							<view class="fee-row">
								<view>包装费</view>
								<view>￥{{ storeInfo.packing_fee }}</view>
							</view>
						</list-cell>
						<list-cell last v-if="storeInfo.delivery_cost > 0">
							<view class="fee-row">
								<view>配送费</view>
								<view>￥{{ storeInfo.delivery_cost }}</view>
							</view>
						</list-cell>
					</template>
				</view>
				<list-cell arrow @click="goToPackages">
					<view class="coupon-row">
						<view class="coupon-label">奈雪券</view>
						<view class="coupon-value">超值购买优惠券大礼包</view>
					</view>
				</list-cell>
				<list-cell arrow>
					<view class="coupon-row">
						<view class="coupon-label">礼品卡</view>
						<view class="coupon-value">请选择</view>
					</view>
				</list-cell>
				<list-cell last>
					<view class="total-row">
						<view class="total-label">总计￥{{ total }},实付</view>
						<view class="total-amount">￥{{ amount }}</view>
					</view>
				</list-cell>
			</view>
			<!-- 购物车列表 end -->
			<view class="tip-row">
				<view class="tip-icon">!</view>
				<view class="tip-text">优惠券不与满赠、满减活动共享</view>
			</view>
			<!-- 支付方式 begin -->
			<view class="payment">
				<list-cell last :hover="false">
					<text>支付方式</text>
				</list-cell>
