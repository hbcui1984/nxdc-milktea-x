					<view class="payment-row disabled">
						<view class="payment-icon balance-icon">余</view>
						<view class="payment-name">余额支付（余额￥0）</view>
						<view class="payment-tip">余额不足</view>
						<view class="payment-checkbox">○</view>
					</view>
				</list-cell>
				<list-cell last>
					<view class="payment-row">
						<view class="payment-icon wechat-icon">微</view>
						<view class="payment-name">微信支付</view>
						<view class="payment-checkbox checked">●</view>
					</view>
				</list-cell>
			</view>
			<!-- 支付方式 end -->
			<!-- 备注 begin -->
			<list-cell arrow last @click="goToRemark">
				<view class="remark-row">
					<view class="remark-label">备注</view>
					<view class="remark-value">{{ form.remark.length > 0 ? form.remark : '点击填写备注' }}</view>
				</view>
			</list-cell>
			<!-- 备注 end -->
		</view>
		<!-- 付款栏 begin -->
		<view class="pay-box">
