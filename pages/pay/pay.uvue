			</view>
		</view>
		<!-- 付款栏 end -->
		<!-- 确认地址弹窗 -->
		<view class="modal-mask" v-if="ensureAddressModalVisible" @click="closeModal">
			<view class="modal-content" @click.stop="">
				<view class="modal-close-wrapper">
					<image src="/static/images/pay/close.png" class="modal-close" @click="closeModal"></image>
				</view>
				<view class="modal-title-wrapper">
					<view class="modal-title">请再次确认下单地址</view>
				</view>
				<view class="modal-address-row">
					<view class="modal-address-name">{{ address.accept_name }} {{ address.sex > 0 ? '女士' : '先生' }}</view>
					<view class="modal-address-mobile">{{ address.mobile }}</view>
				</view>
				<view class="modal-address-detail-row">
					<view class="modal-address-detail">{{ address.street }}{{ address.door_number }}</view>
					<button type="primary" size="mini" plain class="change-address-btn">修改地址</button>
				</view>
				<button type="primary" class="pay-btn" @click="pay">确认并付款</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { state, setOrder, OrderType } from '@/store/index.uts'

// 购物车商品类型
type CartItem = {
	id: number
	name: string
	price: number
	number: number
	props_text: string
}

// 地址类型
type AddressInfo = {
	id: number
	accept_name: string
	mobile: string
	sex: number
	street: string
	door_number: string
}

// 门店类型
type StoreInfoType = {
	id: number
	name: string
	address: string
	packing_fee: number
	delivery_cost: number
}

// 表单类型
type FormData = {
	remark: string
}

const cart = ref<CartItem[]>([])
const form = reactive<FormData>({
	remark: ''
})
const ensureAddressModalVisible = ref<boolean>(false)

const orderType = computed((): string => {
	return state.orderType
})

const address = computed((): AddressInfo => {
	if (state.address != null) {
		return {
			id: state.address!.id,
			accept_name: state.address!.accept_name,
			mobile: state.address!.mobile,
			sex: state.address!.sex,
			street: state.address!.street,
			door_number: state.address!.door_number
		}
	}
	return {
		id: 0,
		accept_name: '',
		mobile: '',
		sex: 0,
		street: '',
		door_number: ''
	}
})

const storeInfo = computed((): StoreInfoType => {
	if (state.store != null) {
		return {
			id: state.store!.id,
			name: state.store!.name,
			address: state.store!.address,
			packing_fee: 0,
			delivery_cost: 0
		}
	}
	return {
		id: 0,
		name: '请选择门店',
		address: '',
		packing_fee: 0,
		delivery_cost: 0
	}
})

const total = computed((): number => {
	let sum: number = 0
	cart.value.forEach((item: CartItem) => {
		sum += item.number * item.price
	})
	return sum
})

const amount = computed((): number => {
	let sum: number = 0
	cart.value.forEach((item: CartItem) => {
		sum += item.number * item.price
	})
	return sum
})

const goToRemark = (): void => {
	uni.navigateTo({
		url: '/pages/remark/remark?remark=' + form.remark
	})
}

const chooseAddress = (): void => {
	uni.navigateTo({
		url: '/pages/address/address?is_choose=true&scene=pay'
	})
}

const goToPackages = (): void => {
	uni.navigateTo({
		url: '/pages/packages/index'
	})
}

const closeModal = (): void => {
	ensureAddressModalVisible.value = false
}

const pay = (): void => {
	uni.showLoading({ title: '加载中' })
	
	// 创建测试订单
	const testOrder: OrderType = {
		id: '1',
		orderNo: 'ABCDEFGHIJKLMN0001',
		status: 1,
		totalPrice: amount.value,
		items: [],
		createTime: new Date().toISOString()
	}
	
	setOrder(testOrder)
	uni.removeStorageSync('cart')
	uni.reLaunch({
		url: '/pages/take-foods/take-foods'
	})
	uni.hideLoading()
}

const submit = (): void => {
	if (orderType.value == 'takeout') {
		ensureAddressModalVisible.value = true
	} else {
		pay()
	}
}

onLoad((option: OnLoadOptions) => {
	const remark = option['remark'] ?? ''
	const cartData = uni.getStorageSync('cart')
	if (cartData != null && cartData != '') {
		// 这里简化处理，实际需要解析存储的数据
		cart.value = []
	}
	if (remark.length > 0) {
		form.remark = remark
	}
})
</script>

