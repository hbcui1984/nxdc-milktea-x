<template>
	<list-cell :hover="false" last class="w-100 d-flex align-items-baseline">
		<view class="font-size-extra-lg text-color-primary mr-40">{{ label }}</view>
		<view class="flex-fill d-flex flex-column">
			<view class="d-flex align-items-center mb-20">
				<view class="iconfont score" v-for="(item, index) in scoreItems" :key="index" @click="handleScoreClick(index)"
					  :class="[modelValue > index ? 'iconshoucangfill' : 'iconshoucang']"
					  :style="getScoreStyle(index)">
				</view>
			</view>
			<view class="font-size-base text-color-base">{{ tips }}</view>
		</view>
	</list-cell>
</template>

<script setup lang="uts">
import listCell from '@/components/list-cell/list-cell.uvue'

const props = defineProps({
	modelValue: {
		type: Number,
		default: 0
	},
	label: {
		type: String,
		default: ''
	},
	tips: {
		type: String,
		default: ''
	}
})

const emit = defineEmits(['update:modelValue'])

const scoreItems = ref<number[]>([0, 1, 2, 3, 4])

const getScoreStyle = (index: number): string => {
	let opacityValue: number = 1
	if (props.modelValue > index && props.modelValue > 0) {
		opacityValue = props.modelValue / 5 + 0.1
	}
	return `opacity: ${opacityValue}`
}

const handleScoreClick = (index: number): void => {
	emit('update:modelValue', index + 1)
}
</script>

<style lang="scss" scoped>
	.score {
		font-size: 28px;
		color: #ccc;
		margin-right: 10px;
	}
	
	.iconshoucangfill {
		color: #f0ad4e;
	}
</style>
