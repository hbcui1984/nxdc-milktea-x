<script setup lang="uts">
import { state, isLogin, setOrderType } from '@/store/index.uts'

const takein = () => {
	setOrderType('takein')
	uni.switchTab({
		url: '/pages/menu/menu'
	})
}

const takeout = () => {
	if (!isLogin.value) {
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	uni.navigateTo({
		url: '/pages/address/address?is_choose=true'
	})
}

const integrals = () => {
	if (!isLogin.value) {
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	uni.navigateTo({
		url: '/pages/integrals/integrals'
	})
}

const packages = () => {
	uni.navigateTo({
		url: '/pages/packages/index'
	})
}

const memberCode = () => {
	if (!isLogin.value) {
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	uni.navigateTo({
		url: '/pages/mine/member-code'
	})
}

const invite = () => {
	uni.navigateTo({
		url: '/pages/activities/invite'
	})
}
</script>

