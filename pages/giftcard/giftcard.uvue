<template>
	<view class="container">
		<view class="tabbar">
			<view class="item" :class="{'active': currentTab == 0}" @click="switchTab(0)">购买礼品卡</view>
			<view class="item" :class="{'active': currentTab == 1}" @click="switchTab(1)">我的礼品卡</view>
		</view>
		<swiper :duration="400" class="swiper" :current="currentTab" @change="onSwiperChange">
			<!-- 购买礼品卡 begin -->
			<swiper-item class="swiper-item-1">
				<scroll-view scroll-y class="scroll-view-1">
					<image :src="giftCardImg" class="w-100" mode="widthFix"/>
					<view class="pl-20 pr-20 mb-30">
						<view class="category-list mt-40" v-for="(category, cIndex) in categoryList" :key="cIndex">
							<view class="font-size-lg font-weight-bold">{{ getCategoryName(category) }}</view>
							<view class="themes-list">
								<view class="theme" v-for="(theme, tIndex) in getThemesList(category)" :key="tIndex">
									<image :src="getThemeImage(theme)" class="theme-img" mode="widthFix"/>
									<view class="activity-name">{{ getThemeActivityName(theme) }}</view>
								</view>
							</view>
						</view>
					</view>
				</scroll-view>
				<view class="footer-1">
					<view>购买须知</view>
					<view class="divider"></view>
					<view>礼品卡章程</view>
				</view>
			</swiper-item>
			<!-- 购买礼品卡 end -->
			<!-- 我的礼品卡 begin -->
			<swiper-item class="swiper-item-2">
				<view class="header">
					<view class="gift-card-types">
						<view class="type-item" :class="{'type-active': giftCardType == 0}" @click="switchGiftCardType(0)">可使用(0)</view>
						<view class="type-item" :class="{'type-active': giftCardType == 1}" @click="switchGiftCardType(1)">不可使用(0)</view>
					</view>
					<view class="d-flex align-items-center text-color-primary">兑换礼品卡</view>
				</view>
				<swiper :duration="400" class="inner-swiper" :current="giftCardType" @change="onGiftCardTypeChange">
					<swiper-item>
						<view v-if="myCardsEmpty" class="d-flex flex-column align-items-center">
							<image src="https://img-shop.qmimg.cn/s16/images/2020/01/11/c1214fe339279c49.png" class="empty-img" mode="widthFix"/>
							<view class="font-size-sm text-color-assist">您暂时还没有礼品卡哦~</view>
						</view>
					</swiper-item>
					<swiper-item>
						<view v-if="myCardsEmpty" class="d-flex flex-column align-items-center">
							<image src="https://img-shop.qmimg.cn/s16/images/2020/01/11/c1214fe339279c49.png" class="empty-img" mode="widthFix"/>
							<view class="font-size-sm text-color-assist">您暂时还没有礼品卡哦~</view>
						</view>
					</swiper-item>
				</swiper>
				<view class="footer-2">
					<button type="primary" plain class="btn-plain">获取记录</button>
					<button type="primary" class="btn-primary">赠送记录</button>
				</view>
			</swiper-item>
			<!-- 我的礼品卡 end -->
		</swiper>
	</view>
</template>

<script setup lang="uts">
import { $api } from '@/api/index.uts'
import { GiftCardsData, CategoryItem, ThemeItem } from '@/api/gift-cards.uts'

// 我的礼品卡类型
type MyCardType = {
	id: string
	name: string
	balance: number
}

const giftCardImg = ref<string>('')
const categoryList = ref<CategoryItem[]>([])
const currentTab = ref<number>(0)
const giftCardType = ref<number>(0)
const myCards = ref<MyCardType[]>([])

const myCardsEmpty = computed((): boolean => {
	return myCards.value.length == 0
})

const getCategoryName = (category: CategoryItem): string => {
	return category.name
}

const getThemesList = (category: CategoryItem): ThemeItem[] => {
	return category.themesList
}

const getThemeImage = (theme: ThemeItem): string => {
	return theme.imageUrls
}

const getThemeActivityName = (theme: ThemeItem): string => {
	return theme.activityName
}

const switchTab = (index: number) => {
	if (currentTab.value == index) return
	currentTab.value = index
}

const onSwiperChange = (e: UniSwiperChangeEvent) => {
	currentTab.value = e.detail.current
}

const switchGiftCardType = (index: number) => {
	if (giftCardType.value == index) return
	giftCardType.value = index
}

const onGiftCardTypeChange = (e: UniSwiperChangeEvent) => {
	giftCardType.value = e.detail.current
}

onShow(async () => {
	const data = await $api<GiftCardsData>('giftCards')
	giftCardImg.value = data.img
	categoryList.value = data.category_list
})
</script>

