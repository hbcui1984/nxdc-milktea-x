<template>
	<view class="container" v-if="!loading">
		<view class="main" v-if="goods.length > 0">
			<view class="nav">
				<view class="header">
					<view class="left" v-if="orderType == 'takein'">
						<view class="store-name">
							<text>{{ storeInfo?.name ?? '' }}</text>
							<view class="iconfont iconarrow-right"></view>
						</view>
						<view class="store-location">
							<image src='/static/images/order/location.png' class="location-icon mr-10"></image>
							<text>距离您 {{ storeInfo?.distance ?? '' }}</text>
						</view>
					</view>
					<view class="left overflow-hidden" v-else>
						<view class="d-flex align-items-center overflow-hidden">
							<image src='/static/images/order/location.png' class="location-icon mr-10"></image>
							<view class="font-size-extra-lg text-color-base font-weight-bold text-truncate">
								{{ address?.street ?? '' }}
							</view>
						</view>
						<view class="font-size-sm text-color-assist overflow-hidden text-truncate">
							由<text class="text-color-base store-name-inline">{{ storeInfo?.name ?? '' }}</text>配送
						</view>
					</view>
					<view class="right">
						<view class="dinein" :class="{active: orderType == 'takein'}" @click="handleSetOrderType('takein')">
							<text>自取</text>
						</view>
						<view class="takeout" :class="{active: orderType == 'takeout'}" @click="takout">
							<text>外卖</text>
						</view>
					</view>
				</view>
				<view class="coupon">
					<text class="title">"霸气mini卡"超级购券活动，赶紧去购买</text>
					<view class="iconfont iconarrow-right"></view>
				</view>
			</view>
			<view class="content">
				<scroll-view class="menus" :scroll-into-view="menuScrollIntoView" scroll-with-animation scroll-y>
					<view class="wrapper">
						<view class="menu" :id="`menu-${item.id}`" :class="{'current': item.id === currentCateId}" v-for="(item, index) in goods" 
						:key="index" @click="handleMenuTap(item.id)">
							<text>{{ item.name }}</text>
							<view class="dot" v-show="menuCartNum(item.id) > 0">{{ menuCartNum(item.id) }}</view>
						</view>
					</view>
				</scroll-view>
				<!-- goods list begin -->
				<scroll-view class="goods" scroll-with-animation scroll-y :scroll-top="cateScrollTop" @scroll="handleGoodsScroll">
					<view class="wrapper">
						<swiper class="ads" id="ads" autoplay :interval="3000" indicator-dots>
							<swiper-item v-for="(item, index) in ads" :key='index'>
								<image :src="item.image"></image>
							</swiper-item>
						</swiper>
						<view class="list">
							<!-- category begin -->
							<view class="category" v-for="(item, index) in goods" :key="index" :id="`cate-${item.id}`">
								<view class="title">
									<text>{{ item.name }}</text>
									<image :src="item.icon" class="icon"></image>
								</view>
								<view class="items">
									<!-- 商品 begin -->
									<view class="good" v-for="(good, key) in item.goods_list" :key="key">
										<image :src="good.images" class="image" @click="showGoodDetailModal(item, good)"></image>
										<view class="right">
											<text class="name">{{ good.name }}</text>
											<text class="tips">{{ good.content }}</text>
											<view class="price_and_action">
												<text class="price">￥{{ good.price }}</text>
												<view class="btn-group" v-if="good.use_property">
													<button type="default" class="btn btn-primary property_btn" hover-class="none"
											 size="mini" @tap="showGoodDetailModal(item, good)">
														选规格
													</button>
													<view class="dot" v-show="goodCartNum(good.id) > 0">{{ goodCartNum(good.id) }}</view>
												</view>
												<view class="btn-group" v-else>
													<button type="default" v-show="goodCartNum(good.id) > 0" plain class="btn reduce_btn"
										 size="mini" hover-class="none" @tap="handleReduceFromCart(item, good)">
														<view class="iconfont iconsami-select"></view>
													</button>
													<view class="number" v-show="goodCartNum(good.id) > 0">{{ goodCartNum(good.id) }}</view>
													<button type="default" class="btn btn-primary add_btn" size="mini" hover-class="none" 
											@tap="handleAddToCart(item, good, 1)">
														<view class="iconfont iconadd-select"></view>
													</button>
												</view>
											</view>
										</view>
									</view>
									<!-- 商品 end -->
								</view>
							</view>
							<!-- category end -->
						</view>
					</view>
				</scroll-view>
				<!-- goods list end -->
			</view>
			<!-- content end -->
			<!-- 购物车栏 begin -->
			<view class="cart-box" v-if="cart.length > 0">
				<view class="cart-mark">
					<image src="/static/images/menu/cart.png" class="cart-img" @click="openCartPopup"></image>
					<view class="cart-tag">{{ getCartGoodsNumber }}</view>
				</view>
				<view class="cart-total-price">￥{{ getCartGoodsPrice }}</view>
				<button type="default" class="cart-pay-btn" @click="toPay" :disabled="disabledPay">
					{{ disabledPay ? `差${spread}元起送` : '去结算' }}
				</button>
			</view>
			<!-- 购物车栏 end -->
		</view>
		<!-- 商品详情模态框 begin -->
		<modal :show="goodDetailModalVisible" class="good-detail-modal" color="#5A5B5C" 
				width="90%" :custom="true" padding="0rpx" radius="12rpx">
			<view class="cover">
				<image v-if="good.images != ''" :src="good.images" class="image"></image>
				<view class="btn-group">
					<image src="/static/images/menu/share-good.png"></image>
					<image src="/static/images/menu/close.png" @click="closeGoodDetailModal"></image>
				</view>
			</view>
			<scroll-view class="detail" scroll-y>
				<view class="wrapper">
					<view class="basic">
						<view class="name">{{ good.name }}</view>
						<view class="tips">{{ good.content }}</view>
					</view>
					<view class="properties" v-if="good.use_property">
						<view class="property" v-for="(item, index) in good.property" :key="index">
							<view class="title">
								<text class="name">{{ item.name }}</text>
								<view class="desc" v-if="item.desc != ''">({{ item.desc }})</view>
							</view>
							<view class="values">
								<view class="value" v-for="(value, key) in item.values" :key="key" 
								:class="{'default': value.is_default == 1}" 
								@click="changePropertyDefault(index, key)">
									{{ value.value }}
								</view>
							</view>
						</view>
					</view>
				</view>
			</scroll-view>
			<view class="action">
				<view class="left">
					<view class="price">￥{{ good.price }}</view>
					<view class="props" v-if="getGoodSelectedProps(good, 'text') != ''">
						{{ getGoodSelectedProps(good, 'text') }}
					</view>
				</view>
				<view class="btn-group">
					<button type="default" plain class="btn" size="mini" hover-class="none" 
						@tap="handlePropertyReduce">
						<view class="iconfont iconsami-select"></view>
					</button>
					<view class="number">{{ good.number }}</view>
					<button type="default" class="btn btn-primary" size="mini" hover-class="none" 
						@tap="handlePropertyAdd">
						<view class="iconfont iconadd-select"></view>
					</button>
				</view>
			</view>
			<view class="add-to-cart-btn" @tap="handleAddToCartInModal">
				<view>加入购物车</view>
			</view>
		</modal>
		<!-- 商品详情模态框 end -->
		<!-- 购物车详情popup -->
		<popup-layer direction="top" :show-pop="cartPopupVisible" class="cart-popup">
			<template #content>
				<view class="top">
					<text @tap="handleCartClear">清空</text>
				</view>
				<scroll-view class="cart-list" scroll-y>
					<view class="wrapper">
						<view class="item" v-for="(item, index) in cart" :key="index">
							<view class="left">
								<view class="name">{{ item.name }}</view>
								<view class="props">{{ item.props_text }}</view>
							</view>
							<view class="center">
								<text>￥{{ item.price }}</text>
							</view>
							<view class="right">
								<button type="default" plain size="mini" class="btn" hover-class="none"
									@tap="handleCartItemReduce(index)">
									<view class="iconfont iconsami-select"></view>
								</button>
								<view class="number">{{ item.number }}</view>
								<button type="primary" class="btn" size="mini" hover-class="none"
									@tap="handleCartItemAdd(index)">
									<view class="iconfont iconadd-select"></view>
								</button>
							</view>
						</view>
						<view class="item" v-if="orderType == 'takeout' && storeInfo != null && storeInfo!.packing_fee > 0">
							<view class="left">
								<view class="name">包装费</view>
							</view>
							<view class="center">
								<text>￥{{ storeInfo!.packing_fee }}</text>
							</view>
							<view class="right invisible">
								<button type="default" plain size="mini" class="btn" hover-class="none">
									<view class="iconfont iconsami-select"></view>
								</button>
								<view class="number">1</view>
								<button type="primary" class="btn" size="mini" hover-class="none">
									<view class="iconfont iconadd-select"></view>
								</button>
							</view>
						</view>
					</view>
				</scroll-view>
			</template>
		</popup-layer>
		<!-- 购物车详情popup -->
	</view>
	<view class="loading" v-else>
		<image src="/static/images/loading.gif"></image>
	</view>
</template>

<script setup lang="uts">
import { state, isLogin, setOrderType, AddressType, StoreType } from '@/store/index.uts'
import modal from '@/components/modal/modal.uvue'
import popupLayer from '@/components/popup-layer/popup-layer.uvue'
import { mockGoods } from '@/api/goods.uts'

// 类型定义
type PropertyValue = {
	id: number
	value: string
	is_default: number
}

type Property = {
	name: string
	desc: string
	values: PropertyValue[]
}

type GoodItem = {
	id: number
	name: string
	content: string
	price: number
	images: string
	use_property: boolean
	property: Property[]
	props_text: string
	props: number[]
	number: number
}

type Category = {
	id: number
	name: string
	icon: string
	goods_list: GoodItem[]
	top: number
	bottom: number
}

type AdItem = {
	image: string
}

type CartItem = {
	id: number
	cate_id: number
	name: string
	price: number
	number: number
	image: string
	use_property: boolean
	props_text: string
	props: number[]
}

const goods = ref<Category[]>([])
const ads = ref<AdItem[]>([
	{ image: 'https://img-shop.qmimg.cn/s23107/2020/04/27/4ebdb582a5185358c4.jpg?imageView2/2/w/600/h/600' },
	{ image: 'https://images.qmai.cn/s23107/2020/05/08/c25de6ef72d2890630.png?imageView2/2/w/600/h/600' },
	{ image: 'https://img-shop.qmimg.cn/s23107/2020/04/10/add546c1b1561f880d.jpg?imageView2/2/w/600/h/600' },
	{ image: 'https://images.qmai.cn/s23107/2020/04/30/b3af19e0de8ed42f61.jpg?imageView2/2/w/600/h/600' },
	{ image: 'https://img-shop.qmimg.cn/s23107/2020/04/17/8aeb78516d63864420.jpg?imageView2/2/w/600/h/600' }
])
const loading = ref<boolean>(true)
const currentCateId = ref<number>(6905)
const cateScrollTop = ref<number>(0)
const menuScrollIntoView = ref<string>('')
const cart = ref<CartItem[]>([])
const goodDetailModalVisible = ref<boolean>(false)
const good = ref<GoodItem>({
	id: 0,
	name: '',
	content: '',
	price: 0,
	images: '',
	use_property: false,
	property: [],
	props_text: '',
	props: [],
	number: 1
})
const category = ref<Category | null>(null)
const cartPopupVisible = ref<boolean>(false)
const sizeCalcState = ref<boolean>(false)

const orderType = computed((): string => {
	return state.orderType
})

const address = computed((): AddressType | null => {
	return state.address
})

const storeInfo = computed((): StoreType | null => {
	return state.store
})

const goodCartNum = (id: number): number => {
	let count = 0
	for (let i = 0; i < cart.value.length; i++) {
		if (cart.value[i].id === id) {
			count += cart.value[i].number
		}
	}
	return count
}

const menuCartNum = (id: number): number => {
	let count = 0
	for (let i = 0; i < cart.value.length; i++) {
		if (cart.value[i].cate_id === id) {
			count += cart.value[i].number
		}
	}
	return count
}

const getCartGoodsNumber = computed((): number => {
	let count = 0
	for (let i = 0; i < cart.value.length; i++) {
		count += cart.value[i].number
	}
	return count
})

const getCartGoodsPrice = computed((): number => {
	let total = 0
	for (let i = 0; i < cart.value.length; i++) {
		total += cart.value[i].number * cart.value[i].price
	}
	return total
})

const disabledPay = computed((): boolean => {
	if (orderType.value == 'takeout' && storeInfo.value != null) {
		const minPrice = storeInfo.value!.min_price
		return getCartGoodsPrice.value < minPrice
	}
	return false
})

const spread = computed((): number => {
	if (orderType.value != 'takeout' || storeInfo.value == null) return 0
	const minPrice = storeInfo.value!.min_price
	return Math.round((minPrice - getCartGoodsPrice.value) * 100) / 100
})

const handleSetOrderType = (type: string) => {
	setOrderType(type)
}

const init = async () => {
	loading.value = true
	console.log('init start, mockGoods.length:', mockGoods.length)
	// 加载模拟商品数据并转换为内部类型
	const loadedGoods: Category[] = []
	for (let i = 0; i < mockGoods.length; i++) {
		const mockCate = mockGoods[i]
		const goodsList: GoodItem[] = []
		for (let j = 0; j < mockCate.goods_list.length; j++) {
			const mockGood = mockCate.goods_list[j]
			const properties: Property[] = []
			for (let k = 0; k < mockGood.property.length; k++) {
				const mockProp = mockGood.property[k]
				const propValues: PropertyValue[] = []
				for (let m = 0; m < mockProp.values.length; m++) {
					const mockVal = mockProp.values[m]
					propValues.push({
						id: mockVal.id,
						value: mockVal.value,
						is_default: mockVal.is_default
					})
				}
				properties.push({
					name: mockProp.name,
					desc: mockProp.desc ?? '',
					values: propValues
				})
			}
			goodsList.push({
				id: mockGood.id,
				name: mockGood.name,
				content: mockGood.content,
				price: mockGood.price,
				images: mockGood.images,
				use_property: mockGood.use_property,
				property: properties,
				props_text: '',
				props: [],
				number: 1
			})
		}
		loadedGoods.push({
			id: mockCate.id,
			name: mockCate.name,
			icon: mockCate.icon,
			goods_list: goodsList,
			top: 0,
			bottom: 0
		})
	}
	goods.value = loadedGoods
	console.log('init complete, goods.value.length:', goods.value.length)
	currentCateId.value = loadedGoods.length > 0 ? loadedGoods[0].id : 0
	loading.value = false
	const savedCart = uni.getStorageSync('cart') as CartItem[] | null
	cart.value = savedCart ?? []
}

const takout = () => {
	if (orderType.value == 'takeout') return

	if (!isLogin.value) {
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}

	uni.navigateTo({
		url: '/pages/address/address?is_choose=true'
	})
}

// 定义类型用于 selector query 返回数据
type SelectorQueryResult = {
	height: number
	width: number
}

const calcSize = () => {
	let h = 10

	const adsQuery = uni.createSelectorQuery().select('#ads')
	adsQuery.fields({
		size: true
	}, (data: any) => {
		if (data != null) {
			const result = data as SelectorQueryResult
			h += Math.floor(result.height)
		}
	}).exec()

	for (let i = 0; i < goods.value.length; i++) {
		const item = goods.value[i]
		const view = uni.createSelectorQuery().select(`#cate-${item.id}`)
		view.fields({
			size: true
		}, (data: any) => {
			if (data != null) {
				const result = data as SelectorQueryResult
				item.top = h
				h += result.height
				item.bottom = h
			}
		}).exec()
	}
	sizeCalcState.value = true
}

const handleMenuTap = (id: number) => {
	if (!sizeCalcState.value) {
		calcSize()
	}

	currentCateId.value = id
	nextTick(() => {
		for (let i = 0; i < goods.value.length; i++) {
			if (goods.value[i].id == id) {
				cateScrollTop.value = goods.value[i].top
				break
			}
		}
	})
}

const handleGoodsScroll = (e: ScrollEvent) => {
	if (!sizeCalcState.value) {
		calcSize()
	}
	const scrollTop = e.detail.scrollTop
	let targetId = currentCateId.value
	for (let i = goods.value.length - 1; i >= 0; i--) {
		if (goods.value[i].top <= scrollTop) {
			targetId = goods.value[i].id
			break
		}
	}
	currentCateId.value = targetId
}

const cloneCart = (): CartItem[] => {
	const nextCart: CartItem[] = []
	for (let i = 0; i < cart.value.length; i++) {
		const item = cart.value[i]
		nextCart.push({
			id: item.id,
			cate_id: item.cate_id,
			name: item.name,
			price: item.price,
			number: item.number,
			image: item.image,
			use_property: item.use_property,
			props_text: item.props_text,
			props: item.props
		})
	}
	return nextCart
}

const handleAddToCart = (cate: Category, goodItem: GoodItem, num: number) => {
	const nextCart = cloneCart()
	let foundIndex = -1
	for (let i = 0; i < nextCart.length; i++) {
		const cartItem = nextCart[i]
		if (goodItem.use_property) {
			if (cartItem.id === goodItem.id && cartItem.props_text === goodItem.props_text) {
				foundIndex = i
				break
			}
		} else {
			if (cartItem.id === goodItem.id) {
				foundIndex = i
				break
			}
		}
	}
	
	if (foundIndex > -1) {
		nextCart[foundIndex].number += num
	} else {
		const newItem: CartItem = {
			id: goodItem.id,
			cate_id: cate.id,
			name: goodItem.name,
			price: goodItem.price,
			number: num,
			image: goodItem.images,
			use_property: goodItem.use_property,
			props_text: goodItem.props_text,
			props: goodItem.props
		}
		nextCart.push(newItem)
	}
	cart.value = nextCart
}

const handleReduceFromCart = (_item: Category, goodItem: GoodItem) => {
	const nextCart = cloneCart()
	let foundIndex = -1
	for (let i = 0; i < nextCart.length; i++) {
		if (nextCart[i].id === goodItem.id) {
			foundIndex = i
			break
		}
	}
	if (foundIndex > -1) {
		nextCart[foundIndex].number -= 1
		if (nextCart[foundIndex].number <= 0) {
			nextCart.splice(foundIndex, 1)
		}
		cart.value = nextCart
	}
}

const showGoodDetailModal = (item: Category, goodItem: GoodItem) => {
	const copyGood = JSON.parse(JSON.stringify(goodItem)) as GoodItem
	copyGood.number = 1
	good.value = copyGood
	category.value = JSON.parse(JSON.stringify(item)) as Category
	goodDetailModalVisible.value = true
}

const closeGoodDetailModal = () => {
	goodDetailModalVisible.value = false
	category.value = null
	good.value = {
		id: 0,
		name: '',
		content: '',
		price: 0,
		images: '',
		use_property: false,
		property: [],
		props_text: '',
		props: [],
		number: 1
	}
}

const changePropertyDefault = (index: number, key: number) => {
	const property = good.value.property[index]
	for (let i = 0; i < property.values.length; i++) {
		property.values[i].is_default = 0
	}
	property.values[key].is_default = 1
	good.value.number = 1
}

const getGoodSelectedProps = (goodItem: GoodItem, type: string): string => {
	if (goodItem.use_property && goodItem.property.length > 0) {
		const props: string[] = []
		for (let i = 0; i < goodItem.property.length; i++) {
			const values = goodItem.property[i].values
			for (let j = 0; j < values.length; j++) {
				if (values[j].is_default == 1) {
					if (type === 'text') {
						props.push(values[j].value)
					}
				}
			}
		}
		return type === 'text' ? props.join('，') : ''
	}
	return ''
}

const handlePropertyAdd = () => {
	good.value.number += 1
}

const handlePropertyReduce = () => {
	if (good.value.number === 1) return
	good.value.number -= 1
}

const handleAddToCartInModal = () => {
	if (category.value == null) return
	const propsText = getGoodSelectedProps(good.value, 'text')
	const product: GoodItem = {
		id: good.value.id,
		name: good.value.name,
		content: good.value.content,
		price: good.value.price,
		images: good.value.images,
		use_property: good.value.use_property,
		property: good.value.property,
		props_text: propsText,
		props: [],
		number: good.value.number
	}
	handleAddToCart(category.value!, product, good.value.number)
	closeGoodDetailModal()
}

const openCartPopup = () => {
	cartPopupVisible.value = !cartPopupVisible.value
}

const handleCartClear = () => {
	uni.showModal({
		title: '提示',
		content: '确定清空购物车么',
		success: (res: ShowModalResult) => {
			if (res.confirm == true) {
				cartPopupVisible.value = false
				cart.value = []
			}
		}
	})
}

const handleCartItemAdd = (index: number) => {
	const nextCart = cloneCart()
	nextCart[index].number += 1
	cart.value = nextCart
}

const handleCartItemReduce = (index: number) => {
	const nextCart = cloneCart()
	if (nextCart[index].number === 1) {
		nextCart.splice(index, 1)
	} else {
		nextCart[index].number -= 1
	}
	cart.value = nextCart
	if (nextCart.length == 0) {
		cartPopupVisible.value = false
	}
}

const toPay = () => {
	if (!isLogin.value) {
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}

	uni.showLoading({ title: '加载中' })
	const cartData = JSON.parse(JSON.stringify(cart.value)) as CartItem[]
	uni.setStorageSync('cart', cartData)

	uni.navigateTo({
		url: '/pages/pay/pay'
	})
	uni.hideLoading()
}

onLoad(() => {
	init()
})
</script>

