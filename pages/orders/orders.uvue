<template>
	<view class="container">
		<view class="orders-list">
			<view class="order-item" v-for="(item, index) in orderList" :key="index" @click="detail(item.id)">
				<list-cell :hover="false">
					<view class="order-header">
						<view class="order-info">
							<view class="store-name">
								{{ item.store.name }}
							</view>
							<view class="order-no">订单编号：{{ item.order_no }}</view>
						</view>
						<view class="order-status">
							{{ item.status_text }}
						</view>
					</view>
				</list-cell>
				<list-cell :hover="false" last>
					<view class="order-content">
						<view class="goods-name">
							{{ orderGoodsName(item.goods) }}
						</view>
						<view class="order-summary">
							<view class="order-time">
								{{ formatDateTime(item.created_at) }}
							</view>
							<view class="order-amount">
								<view class="amount-text">共{{ item.goods_num }}件商品，实付</view>
								<view class="amount-price">￥{{ item.amount }}</view>
							</view>
						</view>
						<view class="order-actions">
							<view class="action-btn" v-if="item.invoice_status > 0">
								<button type="primary" plain size="mini">查看发票</button>
							</view>
							<view class="action-btn" v-else @click.stop="goToInvoice">
								<button type="primary" plain size="mini">开发票</button>
							</view>
							<view class="action-btn" @click.stop="review(item)">
								<button type="primary" plain size="mini">去评价</button>
							</view>
						</view>
					</view>
				</list-cell>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { isLogin } from '@/store/index.uts'
import { $api } from '@/api/index.uts'
import { OrderItem, OrderGoodsItem } from '@/api/orders.uts'

const page = ref<number>(1)
const pageSize = ref<number>(5)
const orderList = ref<OrderItem[]>([])

const orderGoodsName = (goods: OrderGoodsItem[]): string => {
	const arr: string[] = []
	goods.forEach((good: OrderGoodsItem) => {
		arr.push(good.name + '*' + good.number.toString())
	})
	return arr.join('，')
}

const formatDateTime = (timestamp: number): string => {
	const date = new Date(timestamp * 1000)
	const year = date.getFullYear()
	const month = (date.getMonth() + 1).toString().padStart(2, '0')
	const day = date.getDate().toString().padStart(2, '0')
	const hours = date.getHours().toString().padStart(2, '0')
	const minutes = date.getMinutes().toString().padStart(2, '0')
	return `${year}-${month}-${day} ${hours}:${minutes}`
}

const getOrders = async (isRefresh: boolean): Promise<void> => {
	uni.showLoading({ title: '加载中' })
	
	if (isRefresh) {
		orderList.value = []
		page.value = 1
	}
	
	const ordersData = await $api<OrderItem[]>('orders')
	const start = pageSize.value * (page.value - 1)
	const end = pageSize.value * page.value
	const orders = ordersData.slice(start, end)
	
	if (orders.length > 0) {
		orderList.value = orderList.value.concat(orders)
		page.value += 1
	}
	
	uni.hideLoading()
	uni.stopPullDownRefresh()
}

const detail = (id: number): void => {
	uni.navigateTo({
		url: '/pages/orders/detail?id=' + id.toString()
	})
}

const review = (order: OrderItem): void => {
	const date = order.completed_time.split(' ')[0]
	uni.navigateTo({
		url: '/pages/review/review?storename=' + order.store.name + '&typeCate=' + order.typeCate.toString() + '&date=' + date
	})
}

const goToInvoice = (): void => {
	uni.navigateTo({
		url: '/pages/invoice/invoice'
	})
}

onLoad(async () => {
	if (!isLogin.value) {
		uni.navigateTo({ url: '/pages/login/login' })
	}
	await getOrders(false)
})

onReachBottom(async () => {
	await getOrders(false)
})

onPullDownRefresh(async () => {
	await getOrders(true)
})
</script>

<style lang="scss" scoped>
.container {
	display: flex;
	flex-direction: column;
	width: 100%;
}

.orders-list {
	display: flex;
	flex-direction: column;
	width: 100%;
	padding: 10px;
	padding-bottom: 0;
}

.order-item {
	margin-bottom: 15px;
}

.order-header {
	width: 100%;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.order-info {
	flex: 1;
	display: flex;
	flex-direction: column;
}

.store-name {
	font-size: 16px;
	color: #333333;
	margin-bottom: 10px;
}

.order-no {
	font-size: 12px;
	color: #999999;
}

.order-status {
	font-size: 16px;
	color: #b9985e;
}

.order-content {
	width: 100%;
	display: flex;
	flex-direction: column;
}

.goods-name {
	width: 100%;
	font-size: 16px;
	color: #333333;
	margin-bottom: 10px;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.order-summary {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 15px;
}

.order-time {
	font-size: 12px;
	color: #999999;
}

.order-amount {
	display: flex;
	flex-direction: row;
	font-size: 12px;
	color: #333333;
	align-items: center;
}

.amount-text {
	margin-right: 5px;
}

.amount-price {
	font-size: 16px;
}

.order-actions {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
}

.action-btn {
	margin-left: 5px;
}
</style>
