<template>
	<view class="container">
		<view class="textarea-wrapper">
			<textarea placeholder-class="placeholder-style" :value="remark" @input="onRemarkInput"
				class="remark-textarea"
				placeholder="请填写备注信息" :focus="true"/>
			<view class="tips" :class="{'text-color-danger': remarkLength > 50, 'text-color-assist' : remarkLength <= 50}">
				{{ remarkLength }}/50
			</view>
		</view>
		<view class="quick-title">
			快捷输入
		</view>
		<view class="quick-inputs">
			<view class="quick-input" v-for="(item, index) in quickInputs" :key="index" @click="handleQuickInput(item)">
				{{ item }}
			</view>
		</view>
		<view class="submit-wrapper">
			<button type="primary" class="submit-btn" @click="submit">完成</button>
		</view>
	</view>
</template>

<script setup lang="uts">
const remark = ref<string>('')
const quickInputs = ref<string[]>([
	'请放门把手上', '请放门口', '请放前台桌上', '如地址封闭管理，请电话与我联系'
])

onLoad((options: OnLoadOptions) => {
	const remarkParam = options['remark'] as string | null
	if (remarkParam != null) {
		remark.value = remarkParam
	}
})

const remarkLength = computed((): number => {
	return remark.value.length
})

const onRemarkInput = (e: InputEvent) => {
	remark.value = e.detail.value
}

const handleQuickInput = (item: string) => {
	remark.value = remark.value + " " + item
}

const submit = () => {
	uni.navigateTo({
		url: "/pages/pay/pay?remark=" + remark.value
	})
}
</script>

<style lang="scss">
.container {
	padding: 30rpx 40rpx;
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
	overflow: hidden;
	box-sizing: border-box;
}

.textarea-wrapper {
	position: relative;
	display: flex;
	flex-direction: column;
}

.remark-textarea {
	background-color: #FFFFFF;
	width: 100%;
	border-radius: 8rpx;
	padding: 30rpx 40rpx;
	height: 320rpx;
	font-size: 28rpx;
	box-sizing: border-box;
}

.placeholder-style {
	color: #999999;
	font-size: 28rpx;
}

.tips {
	position: absolute;
	bottom: 30rpx;
	right: 40rpx;
	font-size: 24rpx;
}

.text-color-danger {
	color: #f56c6c;
}

.text-color-assist {
	color: #999999;
}

.quick-title {
	display: flex;
	flex-direction: row;
	font-size: 28rpx;
	color: #999999;
	margin-top: 40rpx;
	margin-bottom: 40rpx;
}

.quick-inputs {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: flex-start;
	padding-right: 20rpx;
}

.quick-input {
	background-color: #FFFFFF;
	border-width: 2rpx;
	border-style: solid;
	border-color: #ADB838;
	color: #ADB838;
	font-size: 28rpx;
	padding: 16rpx 26rpx;
	margin-right: 20rpx;
	margin-bottom: 20rpx;
}

.submit-wrapper {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	margin-top: 60rpx;
}

.submit-btn {
	width: 90%;
	height: 80rpx;
	border-radius: 40rpx;
	line-height: 80rpx;
	font-size: 28rpx;
}
</style>
