<template>
	<view class="container">
		<navbar-back-button></navbar-back-button>
		<view class="header">
			<image src="/static/images/attendance/bg.png" mode="scaleToFill"></image>
			<view class="user-box">
				<view class="avatar">
					<image :src="member.avatar"></image>
				</view>
				<view class="nickname">
					{{ member.nickname }}
				</view>
				<view class="rule">
					签到规则
				</view>
			</view>
		</view>
		<view style="padding: 0 30rpx;">
			<view class="integral-box">
				<view class="title">当前积分</view>
				<view class="value">{{ customPoints.totalPoints }}</view>
				<button type="primary" class="btn" @click="attendance">签到</button>
			</view>
			<uni-calendar :show-month="false" :start-date="startDate" 
						  :selected="attendanceList"
						  :continuous="todayAttendance.attendance_continuity_day">
			</uni-calendar>
		</view>
		<modal custom :show="attendanceModalVisible">
			<view class="attendance-modal">
				<view class="modal-header">
					<image src="/static/images/attendance/cup.png" mode="widthFix"></image>
				</view>
				<view class="modal-content d-flex align-items-center just-content-center flex-column font-size-sm text-color-base">
					<view>赠送的1积分已发到您的账户中</view>
					<view>连续签到1天可额外获得1积分</view>
				</view>
				<view class="d-flex align-items-center just-content-center">
					<button type="primary" class="btn" @click="attendanceModalVisible=false">我知道了</button>
				</view>
			</view>
		</modal>
	</view>
</template>

<script setup lang="uts">
import navbarBackButton from '@/components/navbar-back-button.uvue'
import uniCalendar from '@/pages/attendance/uni-calendar/uni-calendar.uvue'
import modal from '@/components/modal/modal.uvue'
import { state } from '@/store/index.uts'
import { $api } from '@/api/index.uts'
import { CustomPointsData } from '@/api/custom-points.uts'
import { AttendanceListItem } from '@/api/attendance-list.uts'
import { TodayAttendanceData } from '@/api/today-attendance.uts'
import { SelectedItem } from '@/pages/attendance/uni-calendar/util.uts'

type MemberInfoType = {
	avatar: string
	nickname: string
}

const customPoints = ref<CustomPointsData>({ soonExpiredPoints: 0, totalPoints: 0, expiredTime: null, foreverPoints: 0 })
const attendanceModalVisible = ref<boolean>(false)
const attendanceList = ref<SelectedItem[]>([])
const todayAttendance = ref<TodayAttendanceData>({
	is_attendance: 0,
	total_points: 0,
	attendance_points: 0,
	attendance_category: 0,
	attendance_continuity_day: 0,
	list: []
})
const startDate = ref<string>('')

const member = computed<MemberInfoType>((): MemberInfoType => {
	if (state.member != null) {
		const info: MemberInfoType = { avatar: state.member!.avatar, nickname: state.member!.nickname }
		return info
	}
	const empty: MemberInfoType = { avatar: '', nickname: '' }
	return empty
})

const attendance = (): void => {
	attendanceModalVisible.value = true
}

onLoad(async (_: OnLoadOptions) => {
	customPoints.value = await $api<CustomPointsData>('customPoints')
	const list = await $api<AttendanceListItem[]>('attendanceList')
	const selected: SelectedItem[] = []
	for (let i = 0; i < list.length; i++) {
		const item: SelectedItem = { date: list[i].date, info: '', data: null }
		selected.push(item)
	}
	attendanceList.value = selected
	todayAttendance.value = await $api<TodayAttendanceData>('todayAttendance')
	const date = new Date()
	const year = date.getFullYear()
	const month = date.getMonth()
	startDate.value = `${year}-${month}-01`
})
</script>

<style lang="scss" scoped>
	.header {
		width: 100%;
		height: 250px;
		position: relative;
		
		image {
			width: 100%;
			height: 100%;
		}
		
		.user-box {
			position: absolute;
			width: 100%;
			top: 44px;
			bottom: 0;
			left: 0;
			display: flex;
			flex-direction: row;
			align-items: center;
			
			.avatar {
				margin-left: 15px;
				background-color: #FFFFFF;
				padding: 3px;
				border-radius: 60px;
				display: flex;
				align-items: center;
				justify-content: center;
				margin-right: 10px;
				
				image {
					width: 50px;
					height: 50px;
					border-radius: 50px;
				}
			}
			
			.nickname {
				font-size: 18px;
				color: #FFFFFF;
				flex: 1;
			}
			
			.rule {
				font-size: 12px;
				color: #FFFFFF;
				border-radius: 25px 0 0 25px;
				background-color: rgba(255, 255, 255, 0.3);
				padding: 5px 15px;
			}
		}
	}
	
	.integral-box {
		position: relative;
		background-color: #FFFFFF;
		border-radius: 4px;
		padding: 15px;
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: -35px;
		margin-bottom: 15px;
		
		.title {
			font-size: 12px;
			color: #999999;
			margin: 10px 0 15px;
		}
		
		.value {
			font-size: 23px;
			font-weight: bold;
			margin-bottom: 15px;
		}
		
		.btn {
			font-size: 16px;
			color: #FFFFFF;
			border-radius: 25px;
			width: 70%;
		}
	}
	
	.attendance-modal {
		.modal-header {
			width: 100%;
			margin-top: -90px;
			position: relative;
			
			image {
				width: 100%;
			}
		}
		
		.modal-content {
			height: 100px;
		}
		
		.btn {
			width: 100%;
			border-radius: 25px;
			font-size: 16px;
		}
	}
</style>
