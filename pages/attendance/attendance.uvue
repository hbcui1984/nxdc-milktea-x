			bottom: 0;
			left: 0;
			display: flex;
			flex-direction: row;
			align-items: center;
			
			.avatar {
				margin-left: 15px;
				background-color: #FFFFFF;
				padding: 3px;
				border-radius: 60px;
				display: flex;
				align-items: center;
				justify-content: center;
				margin-right: 10px;
				
				image {
					width: 50px;
					height: 50px;
					border-radius: 50px;
				}
			}
			
			.nickname {
				font-size: 18px;
				color: #FFFFFF;
				flex: 1;
			}
			
			.rule {
				font-size: 12px;
				color: #FFFFFF;
				border-radius: 25px 0 0 25px;
				background-color: rgba(255, 255, 255, 0.3);
				padding: 5px 15px;
			}
		}
	}
	
	.integral-box {
		position: relative;
		background-color: #FFFFFF;
		border-radius: 4px;
		padding: 15px;
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: -35px;
		margin-bottom: 15px;
		
		.title {
			font-size: 12px;
			color: #999999;
			margin: 10px 0 15px;
		}
		
		.value {
			font-size: 23px;
			font-weight: bold;
			margin-bottom: 15px;
		}
		
		.btn {
			font-size: 16px;
			color: #FFFFFF;
			border-radius: 25px;
			width: 70%;
		}
	}
	
	.attendance-modal {
		.modal-header {
			width: 100%;
			margin-top: -90px;
			position: relative;
			
			image {
				width: 100%;
			}
		}
		
		.modal-content {
			height: 100px;
		}
		
		.btn {
			width: 100%;
			border-radius: 25px;
			font-size: 16px;
		}
	}
